{
  "cli": {
    "version": ">=24.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.21.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.7:4000/v1"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "24.21.0",
      "autoIncrement": true,
      "env": {
        "RAAHI_RELEASE_CHANNEL": "production"
      }
    }
  }
}
