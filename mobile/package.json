{
  "name": "@raahi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "eas-build-post-install": "npm --workspace @raahi/contracts run build",
    "check:production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "@raahi/contracts": "0.1.0",
    "expo-secure-store": "~57.0.4",
    "expo-apple-authentication": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "socket.io-client": "^4.8.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-image-manipulator": "~57.0.21",
    "expo-location": "~57.0.20",
    "expo-contacts": "~57.0.6",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/node": "^22.14.0",
    "typescript": "~6.0.3",
    "tsx": "^4.20.0"
  }
}
