{
  "expo": {
    "name": "Travel Buddy",
    "slug": "travel-buddy",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "travelbuddy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raahi.travel",
      "usesAppleSignIn": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.raahi.travel",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Travel Buddy uses your precise location only when you choose Use my location, to confirm your city. Exact coordinates are not shown to other travelers."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Travel Buddy uses contacts only when you choose Find friends to send an invitation. Your address book stays on this device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Travel Buddy uses photos you select for your travel profile. Limited photo access works too.",
          "cameraPermission": "Travel Buddy uses the front camera when you choose to submit a selfie for identity review.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ed32386-7407-4bc1-8962-b98ba063fa2b"
      }
    },
    "owner": "shivbu22"
  }
}
